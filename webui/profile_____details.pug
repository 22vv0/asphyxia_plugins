//DATA//
  profile: DB.FindOne(refid, { collection: "profile" })
  profile3: DB.FindOne(refid, { collection: "profile3" })
  score3: DB.Find(refid, { collection: "score3" })

-
style.
  .crs-div {
    display: block;
    background-color: #dbdbdb;
  }

  @media screen and (max-width: 768px) {
    .crs-div {
      height: 1px;
      width: 100%;
      margin: 1.5rem 0;
    }
  }

  @media screen and (min-width: 769px) {
    .crs-div {
      width: 1px;
      height: 50px;
      align-items: center;
      margin: 0 1.5rem;
    }
  }

if profile3
  div
    .card
      .card-header
        p.card-header-title
          span.icon
            i.mdi.mdi-account
          | Basic Info

      .card-content
        table.basic_data
          tr
            td Dancer Name
            td #{profile3.dancerName}
          tr
            td DDR Code
              td #{profile3.ddrCode}
          tr(id="area")
              td Area
          tr
              td Total Plays
              td #{profile3.playCount}

    .card
      .card-header
        p.card-header-title
          span.icon
            i.mdi.mdi-arrow-up-bold-outline
          | Dan Rankings

      .card-content.danrank
        .columns.is-vcentered
          .column
            span(style="font-size: 1em;") Single Style
            br
            span.singlerank(style="font-size: 1.2em;") Loading
          .crs-div
          .column
            span(style="font-size: 1em;") Double Style
            br
            span.doublerank(style="font-size: 1.2em;") Loading


    .card
      .card-header
        p.card-header-title
          span.icon
            i.mdi.mdi-fire
          | Flare Skill

      .card-content
        table.flare_skill
            th 
            th SINGLE
            th DOUBLE
            tr(id="skillrank")
                td Rank
                td#srs --
                td#srd --
            tr(id="skilltotal")
                td Total
                td#sts --
                td#std --
            tr(id="skillclassic")
                td CLASSIC
                td#scs --
                td#scd --
            tr(id="skillwhite")
                td WHITE
                td#sws --
                td#swd --
            tr(id="skillgold")
                td GOLD
                td#sgs --
                td#sgd --

    div(hidden id='profile3-pass') !{JSON.stringify(profile3)}
    div(hidden id='score-pass') !{JSON.stringify(score3)}
    script(src="static/js/profile_details.js")
    script(src="static/js/common.js")
