//DATA//
  profile3: DB.FindOne(refid, { collection: "profile3" })
  score3: DB.Find(refid, { collection: "score3" })

-
link(rel="stylesheet" href="static/css/datatables.css")
style.
  .crs-div {
    display: block;
    background-color: #dbdbdb;
  }

  @media screen and (max-width: 768px) {
    .crs-div {
      height: 1px;
      width: 100%;
      margin: 1.5rem 0;
    }
  }

  @media screen and (min-width: 769px) {
    .crs-div {
      width: 1px;
      height: 150px;
      align-items: center;
      margin: 0 1.5rem;
    }
  }

if profile3
  div
    .card
      .card-header
        p.card-header-title
          span.icon
            i.mdi.mdi-filter
          | Filter Results
      .card-content
        .score-filter
          .field.is-horizontal.has-addons
            .field-label.is-normal
              label.label Chart Style
            .field-body
              .control
                .select
                  select(id="style_select" value=0)
                    option(value=0) SINGLE
                    option(value=1) DOUBLE
          .field.is-horizontal.has-addons
            .field-label.is-normal
              label.label Displayed Info
            .field-body
              .control
                .select
                  select(id="info_select" value=0)
                    option(value=0) Score
                    option(value=1) Clear Rank
                    option(value=2) Clear Type
                    option(value=3) Flare Rank

    .card
      .card-header
        p.card-header-title
          span.icon
            i.mdi.mdi-music
          | Music Data

      .card-content
        .score-table
          table.table(id="musicdata" style="width:100%")
            colgroup
              col(span="6")
              col(span="7" style="visibility: collapse;")
            thead
              tr    
                th Song
                th BEGINNER
                th BASIC
                th DIFFICULT
                th EXPERT
                th CHALLENGE
                th BEVAL
                th BAVAL
                th DIFVAL
                th EXPVAL
                th CHAVAL
            tbody
            
div(hidden id='score-pass') !{JSON.stringify(score3)}
script(src="static/js/common.js")
script(src="static/js/profile_musicdata.js")
script(src="static/js/datatables.js")
