link(rel="stylesheet" href="static/css/datatables.css")
style.
  .crs-div {
    display: block;
    background-color: #dbdbdb;
  }

  @media screen and (max-width: 768px) {
    .crs-div {
      height: 1px;
      width: 100%;
      margin: 1.5rem 0;
    }
  }

  @media screen and (min-width: 769px) {
    .crs-div {
      width: 1px;
      height: 150px;
      align-items: center;
      margin: 0 1.5rem;
    }
  }

  .dot {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    margin-right: 5px;
  }

  .dot.none  { background-color: white; opacity: 25%; }
  .dot.g   { background-color: #28d42b; }
  .dot.y { background-color: #f5b433; }

